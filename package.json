{
  "name": "sec-data-fetcher",
  "version": "2.0.0",
  "description": "SEC EDGAR filings and financial-data toolkit for Node.js: company facts, submissions, XML parsing and HTML tables.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run check",
    "test": "jest --runInBand",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "example": "node dist/example.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:live": "npm run build && node scripts/test-live.mjs",
    "check": "npm run lint && npm test && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianBoehler/sec-data-fetcher.git"
  },
  "keywords": [
    "sec",
    "edgar",
    "sec-edgar",
    "sec-filings",
    "financial-data",
    "xbrl",
    "typescript",
    "nodejs",
    "10-k",
    "10-q",
    "html-tables"
  ],
  "author": "Sebastian Boehler",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "axios-rate-limit": "^1.9.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/SebastianBoehler/sec-data-fetcher#readme",
  "bugs": {
    "url": "https://github.com/SebastianBoehler/sec-data-fetcher/issues"
  }
}
